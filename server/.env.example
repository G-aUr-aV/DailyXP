# MongoDB
MONGODB_URI=mongodb://localhost:27017/dailyxp

# LLM Provider: 'cerebras' or 'gemini'
LLM_PROVIDER=cerebras

# LLM Settings
LLM_TEMPERATURE=0

# LLM (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Cerebras (current)
CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_MODEL=llama-4-scout-17b-16e-instruct

# YouTube Data API (for video duration)
YOUTUBE_DATA_API_V3_KEY=your-youtube-api-key-here

# Email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
DAILY_EMAIL_RECIPIENT=your-email@gmail.com

# Server
PORT=3001
NODE_ENV=development
TIMEZONE=Asia/Kolkata

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
